# ===========================================
# BLACK EDITION OS - Environment Variables
# ===========================================

# -----------------
# APPLICATION
# -----------------
NODE_ENV=development
APP_NAME="Black Edition OS"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# -----------------
# DATABASE
# -----------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/blackedition

# -----------------
# REDIS
# -----------------
REDIS_URL=redis://localhost:6379

# -----------------
# CLERK AUTHENTICATION
# -----------------
# Get your keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk URLs (optional customization)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------
# ANTHROPIC CLAUDE API
# -----------------
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_MAX_TOKENS=4096

# -----------------
# EMAIL (RESEND)
# -----------------
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=noreply@blackedition.com
SUPPORT_EMAIL=support@blackedition.com

# -----------------
# PAYMOB (EGYPTIAN PAYMENT GATEWAY)
# -----------------
# Get credentials from https://accept.paymob.com
PAYMOB_API_KEY=xxxxx
PAYMOB_INTEGRATION_ID=xxxxx
PAYMOB_IFRAME_ID=xxxxx
PAYMOB_HMAC_SECRET=xxxxx
PAYMOB_PUBLIC_KEY=xxxxx

# -----------------
# STRIPE (INTERNATIONAL PAYMENTS - OPTIONAL)
# -----------------
# Get credentials from https://stripe.com
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# -----------------
# CLOUDFLARE R2 (FILE STORAGE)
# -----------------
# Get credentials from Cloudflare dashboard
R2_ACCOUNT_ID=xxxxx
R2_ACCESS_KEY_ID=xxxxx
R2_SECRET_ACCESS_KEY=xxxxx
R2_BUCKET_NAME=black-edition-files
R2_PUBLIC_URL=https://xxxxx.r2.cloudflarestorage.com

# -----------------
# SENTRY (ERROR TRACKING)
# -----------------
# Get DSN from https://sentry.io
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ORG=black-edition
SENTRY_PROJECT=black-edition-os
SENTRY_AUTH_TOKEN=xxxxx

# -----------------
# JWT & SECURITY
# -----------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
ENCRYPTION_KEY=your-32-character-encryption-key

# -----------------
# RATE LIMITING
# -----------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------
# CORS
# -----------------
CORS_ORIGIN=http://localhost:3000

# -----------------
# LOGGING
# -----------------
LOG_LEVEL=info

# -----------------
# FEATURE FLAGS
# -----------------
ENABLE_AI_FEATURES=true
ENABLE_STRIPE_PAYMENTS=false
ENABLE_REAL_TIME_MESSAGING=false

# -----------------
# MONITORING
# -----------------
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true
